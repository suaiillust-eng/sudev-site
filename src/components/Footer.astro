---
import { withBase } from '../lib/url';
import { site, xUrl } from '../data/site';

const home = withBase('/');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand-col">
      <p class="brand">{site.name}</p>
      <p class="note">個人開発でアプリをつくっています。</p>
    </div>
    <nav aria-label="フッターナビゲーション">
      <ul>
        <li><a href={`${home}#featured`}>Apps</a></li>
        <li><a href={`${home}#about`}>About</a></li>
        {xUrl && <li><a href={xUrl} target="_blank" rel="noopener">X</a></li>}
        <li><a href={withBase('/contact')}>Contact</a></li>
        <li><a href={withBase('/privacy')}>Privacy Policy</a></li>
      </ul>
    </nav>
  </div>
  <div class="container copy">© {year} {site.name}</div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 40px 32px;
    background: var(--bg-soft);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .brand { font-size: 18px; font-weight: 800; margin: 0; }
  .note { color: var(--text-dim); font-size: 13px; margin: 4px 0 0; }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a { text-decoration: none; color: var(--text-muted); font-size: 14px; }
  a:hover { color: var(--text); }

  .copy { color: var(--text-dim); font-size: 12px; margin-top: 28px; }
</style>
