---
import type { App } from '../data/apps';
import AppIcon from './AppIcon.astro';
import { withBase } from '../lib/url';

interface Props {
  app: App;
}
const { app } = Astro.props;
const isDev = app.status === 'development';
---

<article class="card" style={`--app-accent:${app.accent}`}>
  <AppIcon app={app} size={56} decorative />
  <div class="text">
    <div class="title-row">
      <h3>
        {/* カード全体をこのリンクの当たり判定にする（::after） */}
        <a class="title-link" href={withBase(`/apps/${app.slug}`)}>{app.name}</a>
      </h3>
      {isDev && <span class="badge badge-dev">{app.progress ?? '開発中'}</span>}
    </div>
    <p class="summary">{app.summary}</p>
    {app.notice && <p class="notice"><span class="badge badge-notice">{app.notice}</span></p>}
    <div class="meta">
      <span class="more">詳しく見る →</span>
      {app.appStoreUrl && (
        <a class="store" href={app.appStoreUrl} target="_blank" rel="noopener">
          App Store で見る
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 18px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--app-accent) var(--tint-border-amt), var(--line));
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .card > :global(.icon-img) { flex: none; }

  .text { min-width: 0; }

  .title-row {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }

  h3 { font-size: 17px; font-weight: 700; }

  .title-link { text-decoration: none; }

  /* カードのどこを押しても詳細ページへ */
  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .summary {
    margin: 6px 0 0;
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .notice { margin: 10px 0 0; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 12px;
  }

  .more {
    font-size: 13px;
    font-weight: 700;
    color: color-mix(in srgb, var(--app-accent) var(--accent-text-amt), var(--accent-text-base));
  }

  /* App Store リンクはカード全体のリンクより前面に置く */
  .store {
    position: relative;
    z-index: 1;
    font-size: 12.5px;
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    line-height: 1.5;
  }

  .store:hover { color: var(--text); }
</style>
