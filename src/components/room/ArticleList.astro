---
import { articleTopic, formatDate, type Article } from '../../lib/articles';
import { withBase } from '../../lib/url';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

<ul class="articles">
  {articles.map((article) => {
    const topic = articleTopic(article);
    return (
      <li>
        <a class="item" href={withBase(`/suzuha/articles/${article.id}`)}>
          <time datetime={article.data.date.toISOString().slice(0, 10)}>{formatDate(article.data.date)}</time>
          <span class="title">{article.data.title}</span>
          <span class="desc">{article.data.description}</span>
        </a>
        {topic.slug === null ? (
          <span class="cat">{topic.label}</span>
        ) : (
          <a class="cat" href={withBase(`/suzuha/articles/category/${topic.slug}`)}>{topic.label}</a>
        )}
      </li>
    );
  })}
</ul>

<style>
  .articles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .articles li {
    position: relative;
    display: grid;
    grid-template-columns: 7.5em 1fr;
    column-gap: 18px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
  }
  .item {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    gap: 2px 18px;
    text-decoration: none;
    color: var(--ink);
  }
  .item:hover .title { text-decoration: underline; text-decoration-color: var(--asagi); text-underline-offset: 5px; }
  time { grid-row: span 2; font-size: 13px; color: var(--ink-soft); padding-top: 3px; }
  .title { font-weight: 700; color: var(--obi); font-size: 16.5px; line-height: 1.6; }
  .desc { font-size: 14px; color: var(--ink-soft); line-height: 1.75; }
  .cat {
    grid-column: 2;
    justify-self: start;
    margin-top: 8px;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: #fff;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a.cat:hover { border-color: var(--asagi); color: var(--obi); }

  @media (max-width: 560px) {
    .articles li, .item { grid-template-columns: 1fr; }
    time { grid-row: auto; padding: 0; }
    .cat { grid-column: 1; }
  }
</style>
