---
import Room from '../../layouts/Room.astro';
import { existsSync } from 'node:fs';
import GalleryThumbs from '../../components/room/GalleryThumbs.astro';
import ArticleList from '../../components/room/ArticleList.astro';
import { listGallery } from '../../lib/gallery';
import { listArticles } from '../../lib/articles';
import { greeting, heroImage } from '../../data/suzuha';
import { withBase } from '../../lib/url';

const gallery = await listGallery();
const articles = await listArticles();
// トップの絵が置かれていなければ、淡い色の帯の上にあいさつを出す
const hasHero = existsSync(new URL(`../../../public${heroImage.image}`, import.meta.url));
---

<Room
  title="涼葉の部屋"
  description="SULab の涼葉の部屋です。涼葉が書いた記事と、飾った絵を置いています。"
  path="/suzuha"
>
  <section class="hero" aria-label="あいさつ">
    {hasHero && (
      <img
        class="hero-img"
        src={withBase(heroImage.image)}
        alt={heroImage.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="room-wrap hero-inner">
      <div class="greeting voice">
        {greeting.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </section>

  <section class="room-wrap block" aria-labelledby="new-articles">
    <h2 class="room-h2" id="new-articles">新しい記事</h2>
    {articles.length === 0 ? (
      <p class="room-empty">まだ記事はありません。</p>
    ) : (
      <ArticleList articles={articles.slice(0, 3)} />
    )}
    {articles.length > 3 && <a class="room-more" href={withBase('/suzuha/articles')}>記事をすべて見る</a>}
  </section>

  <section class="room-wrap block" aria-labelledby="new-art">
    <h2 class="room-h2" id="new-art">新しく飾った絵</h2>
    {gallery.length === 0 ? (
      <p class="room-empty">まだ絵を飾っていません。飾ったら、ここに並べていくね。</p>
    ) : (
      <GalleryThumbs items={gallery.slice(0, 4)} />
    )}
    {gallery.length > 4 && <a class="room-more" href={withBase('/suzuha/gallery')}>ギャラリーをすべて見る</a>}
  </section>
</Room>

<style>
  /* トップの絵は、画面の幅いっぱいの横長。あいさつは絵の左側に重ねる */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(360px, 42vw, 560px);
    overflow: hidden;
    background: linear-gradient(120deg, #eef5f7, #dbe9ee);
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* 文字を読みやすくする、左から薄くかかる白いもや */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(248, 251, 252, 0.88) 0%,
      rgba(248, 251, 252, 0.6) 34%,
      rgba(248, 251, 252, 0) 62%
    );
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(40px, 7vw, 80px);
  }

  .greeting {
    max-width: 30em;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 2;
  }
  .greeting p { margin: 0; }
  .greeting p:first-child {
    font-size: 1.35em;
    font-weight: 600;
    margin-bottom: 0.4em;
  }

  .block { margin-top: clamp(40px, 8vw, 72px); max-width: 860px; }

  /* 狭い画面では、絵を上に見せて、あいさつは下に重ねる */
  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
      min-height: clamp(380px, 110vw, 520px);
    }
    .hero-img { object-position: 70% center; }
    .hero-scrim {
      background: linear-gradient(
        0deg,
        rgba(248, 251, 252, 0.92) 0%,
        rgba(248, 251, 252, 0.7) 38%,
        rgba(248, 251, 252, 0) 65%
      );
    }
    .hero-inner { padding-block: 32px 28px; }
    .greeting { line-height: 1.9; }
  }
</style>
