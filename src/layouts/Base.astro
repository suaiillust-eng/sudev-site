---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** OGP 画像（public/ 以下のパス） */
  ogImage?: string;
  /** ページ固有の canonical パス（例: '/apps/data-jong'） */
  path?: string;
}

const { title, description, ogImage = '/og.jpg', path = '/' } = Astro.props;
const pageTitle = title === site.name ? `${site.name} — 個人開発アプリ` : `${title} | ${site.name}`;
const canonical = new URL(withBase(path), Astro.site ?? site.url).toString();
const ogUrl = new URL(withBase(ogImage), Astro.site ?? site.url).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0a0b0e" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {site.xHandle && <meta name="twitter:site" content={`@${site.xHandle}`} />}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // 自分のアクセスは計測対象から外す。
      // 一度だけ ?meonly=1 を付けて開くと、このブラウザには目印が残り、
      // 以降そのブラウザからのアクセスは計測しない（ブラウザ単位・端末単位）。
      (function () {
        try {
          if (new URLSearchParams(location.search).get('meonly') === '1') {
            localStorage.setItem('su-owner', '1');
          }
          if (localStorage.getItem('su-owner') === '1') return;
        } catch (e) {}
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', '{"token": "1842c0a47b7443a1b505f4cc7f062987"}');
        document.body.appendChild(s);
      })();
    </script>
  </body>
</html>
