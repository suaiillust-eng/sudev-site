---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { listArticles, formatDate, type Article } from '../../lib/articles';
import { authors, ARTICLE_DISCLOSURE } from '../../data/authors';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await listArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content } = await render(article);
const author = authors[article.data.author];
---

<Base
  title={article.data.title}
  description={article.data.description}
  path={`/articles/${article.id}`}
>
  <article class="section">
    <div class="container narrow">
      <a class="back" href={withBase('/articles')}>← 記事の一覧</a>
      <header>
        <time datetime={article.data.date.toISOString().slice(0, 10)}>
          {formatDate(article.data.date)}
        </time>
        <h1>{article.data.title}</h1>
        <p class="byline">{author.byline}</p>
      </header>

      <!-- 全記事に必ず出す一文。記事担当（AI）には書かせず、ここで出す -->
      <p class="disclosure">{ARTICLE_DISCLOSURE}</p>

      <div class="prose">
        <Content />
      </div>

      <div class="author-wrap">
        <AuthorCard author={article.data.author} />
      </div>
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 760px; }

  .back {
    display: inline-block;
    margin-bottom: clamp(22px, 5vw, 36px);
    font-size: 13.5px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--text); }

  time { font-size: 12.5px; color: var(--text-dim); letter-spacing: 0.04em; }
  h1 { font-size: clamp(26px, 6vw, 36px); font-weight: 800; margin-top: 6px; }
  .byline { margin: 10px 0 0; font-size: 14px; color: var(--text-muted); }

  .disclosure {
    margin: 24px 0 0;
    padding: 12px 16px;
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .prose { margin-top: 32px; font-size: 16px; line-height: 1.95; }
  .prose :global(h2) { font-size: 22px; font-weight: 700; margin: 2.2em 0 0.6em; }
  .prose :global(h3) { font-size: 18px; font-weight: 700; margin: 1.8em 0 0.5em; }
  .prose :global(p) { margin: 0 0 1.2em; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.4em; }
  .prose :global(li) { margin: 0.3em 0; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(blockquote) {
    margin: 0 0 1.2em;
    padding: 4px 0 4px 16px;
    border-left: 3px solid var(--line-strong);
    color: var(--text-muted);
  }
  .prose :global(code) {
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .prose :global(pre) {
    margin: 0 0 1.2em;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow-x: auto;
  }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(img) { border-radius: var(--radius); margin: 0 auto; }

  .author-wrap { margin-top: 48px; }
</style>
