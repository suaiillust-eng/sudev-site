---
import { withBase } from '../../lib/url';
import type { TopicSummary } from '../../lib/articles';

interface Props {
  /** 実際にあるカテゴリー（記事の数つき。listTopics の結果）。 */
  topics: TopicSummary[];
  /** すべての記事の数。 */
  total: number;
  /** いま見ているカテゴリーの slug。すべてなら undefined。 */
  current?: string | undefined;
}

const { topics, total, current } = Astro.props;
const links = [
  { label: 'すべて', count: total, href: withBase('/suzuha/articles'), active: current === undefined },
  ...topics.map((topic) => ({
    label: topic.label,
    count: topic.count,
    href: withBase(`/suzuha/articles/category/${topic.slug}`),
    active: current === topic.slug,
  })),
];
---

<nav class="cats" aria-label="記事のカテゴリー">
  {links.map((link) => (
    <a href={link.href} aria-current={link.active ? 'page' : undefined}>
      <span class="label">{link.label}</span><span class="count">{link.count}</span>
    </a>
  ))}
</nav>

<style>
  .cats { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 22px; }
  .cats a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    max-width: 100%;
    padding: 5px 13px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 13.5px;
    color: var(--ink);
    text-decoration: none;
    background: #fff;
  }
  .cats .label { overflow-wrap: anywhere; }
  .cats .count { font-size: 11.5px; color: var(--ink-soft); }
  .cats a:hover { border-color: var(--asagi); }
  .cats a[aria-current='page'] { background: var(--obi); border-color: var(--obi); color: #fff; }
  .cats a[aria-current='page'] .count { color: rgba(255, 255, 255, 0.78); }
</style>
