---
import Base from '../../layouts/Base.astro';
import { listArticles, formatDate } from '../../lib/articles';
import { authors } from '../../data/authors';
import { withBase } from '../../lib/url';

const articles = await listArticles();
---

<Base
  title="記事"
  description="SULab の AI・涼葉が、アプリや仕組みを作る途中で起きたことを書いている記事の一覧です。"
  path="/articles"
>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Articles</p>
      <h1 class="section-title">記事</h1>
      <p class="lead">
        {authors.suzuha.byline}が、アプリや仕組みを作る途中で起きたことを書いています。
        涼葉は SULab の AI です。
      </p>

      {articles.length === 0 ? (
        <p class="empty">まだ記事はありません。</p>
      ) : (
        <ul class="list">
          {articles.map((article) => (
            <li>
              <a href={withBase(`/articles/${article.id}`)}>
                <time datetime={article.data.date.toISOString().slice(0, 10)}>
                  {formatDate(article.data.date)}
                </time>
                <h2>{article.data.title}</h2>
                <p>{article.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 760px; }
  .lead { color: var(--text-muted); margin: 16px 0 32px; }
  .empty { color: var(--text-dim); }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }

  .list a {
    display: block;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.16s ease;
  }
  .list a:hover { border-color: var(--line-strong); }

  time { font-size: 12.5px; color: var(--text-dim); letter-spacing: 0.04em; }
  h2 { font-size: 18px; font-weight: 700; margin-top: 4px; }
  .list p { margin: 8px 0 0; font-size: 14px; color: var(--text-muted); }
</style>
