---
import { render } from 'astro:content';
import Room from '../../../layouts/Room.astro';
import AuthorCard from '../../../components/AuthorCard.astro';
import { listArticles, formatDate, type Article } from '../../../lib/articles';
import { authors, ARTICLE_DISCLOSURE } from '../../../data/authors';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const articles = await listArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content } = await render(article);
const author = authors[article.data.author];
---

<Room
  title={article.data.title}
  description={article.data.description}
  path={`/suzuha/articles/${article.id}`}
>
  <article class="room-wrap reading">
    <a class="back" href={withBase('/suzuha/articles')}>記事の一覧にもどる</a>
    <header>
      <time datetime={article.data.date.toISOString().slice(0, 10)}>
        {formatDate(article.data.date)}
      </time>
      <h1>{article.data.title}</h1>
      <p class="byline">{author.byline}</p>
    </header>

    <!-- 全記事に必ず出す一文。記事担当（AI）には書かせず、ここで出す -->
    <p class="disclosure">{ARTICLE_DISCLOSURE}</p>

    <div class="prose">
      <Content />
    </div>

    <div class="author-wrap">
      <AuthorCard author={article.data.author} />
    </div>
  </article>
</Room>

<style>
  .reading { max-width: 760px; padding-top: clamp(28px, 6vw, 48px); }

  .back { font-size: 14px; color: var(--ink-soft); text-underline-offset: 4px; }

  header { margin-top: clamp(22px, 5vw, 36px); }
  time { font-size: 13px; color: var(--ink-soft); }
  h1 { font-size: clamp(25px, 5.6vw, 34px); font-weight: 700; color: var(--obi); margin-top: 6px; }
  .byline { margin: 10px 0 0; font-size: 14px; color: var(--ink-soft); }

  .disclosure {
    margin: 24px 0 0;
    padding: 12px 16px;
    border-radius: 12px;
    border-left: 4px solid var(--obi);
    background: var(--mizu-soft);
    font-size: 13.5px;
    color: var(--ink);
  }

  .prose { margin-top: 32px; font-size: 16.5px; line-height: 2; color: var(--ink); }
  .prose :global(h2) { font-size: 21px; font-weight: 700; color: var(--obi); margin: 2.2em 0 0.6em; }
  .prose :global(h3) { font-size: 17.5px; font-weight: 700; color: var(--obi); margin: 1.8em 0 0.5em; }
  .prose :global(p) { margin: 0 0 1.2em; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.4em; }
  .prose :global(li) { margin: 0.3em 0; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 4px; }
  .prose :global(blockquote) {
    margin: 0 0 1.2em;
    padding: 4px 0 4px 16px;
    border-left: 3px solid var(--asagi);
    color: var(--ink-soft);
  }
  .prose :global(code) { font-size: 0.9em; padding: 2px 6px; border-radius: 6px; background: var(--mizu-soft); }
  .prose :global(pre) {
    margin: 0 0 1.2em;
    padding: 16px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    overflow-x: auto;
  }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(img) { border-radius: 12px; margin: 0 auto; }

  .author-wrap { margin-top: 48px; }
</style>
